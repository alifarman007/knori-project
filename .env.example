# KnoRI — environment variables
# Copy to .env and fill in. Never commit .env.
# Every variable the app reads is listed here (plan.md §9).

# ---------------------------------------------------------------- core
ENV=dev                      # dev | prod
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
LOG_LEVEL=info               # debug | info | warning | error
SESSION_SECRET=change-me-to-32-random-bytes

# ---------------------------------------------------------------- database
# Local dev (docker compose): the db container publishes 55432 on the host,
# so it never clashes with a Postgres you already have installed.
DATABASE_URL=postgresql+asyncpg://knori:knori@localhost:55432/knori

# ---------------------------------------------------------------- LLM providers
# Anthropic is the primary provider (chat + all Recognition reasoning).
ANTHROPIC_API_KEY=
# OpenAI is used for embeddings, and optionally as an alternative chat/reasoning provider.
OPENAI_API_KEY=
OPENAI_REASONING_MODEL=gpt-5.6-sol
OPENAI_BACKGROUND_MODEL=gpt-5.6-terra

# fake  = no network, scripted replies from tests/fixtures (used by tests and for a keyless demo)
# live  = real API calls
LLM_MODE=fake
DEBUG_PAYLOADS=false         # true stores raw request/response in the debug log (dev only)

# Per-task route overrides, e.g. KNORI_ROUTE__chat_reply=openai:gpt-5.6-sol:medium
# KNORI_ROUTE__chat_reply=

# ---------------------------------------------------------------- jobs
WORKER_CONCURRENCY=4
KNORI_DEV_NOW=               # dev/test only: freeze "now", e.g. 2026-09-21T10:00:00Z

# ---------------------------------------------------------------- signup
SIGNUP_MODE=invite           # invite | open
FIRST_INVITE_CODE=KNORI-DEV  # created on first boot in dev so you can sign up

# ---------------------------------------------------------------- email
SMTP_HOST=localhost
SMTP_PORT=1025               # mailpit in dev
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=KnoRI <hello@knori.local>
SMTP_TLS=false

# ---------------------------------------------------------------- backups (VPS only)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
BACKUP_KEY=                  # restic/age password for encrypted dumps

# ---------------------------------------------------------------- optional
SENTRY_DSN=
